# Tawk.to live chat widget
# Sign up at https://www.tawk.to and grab the two IDs from your embed snippet.
# Both are public — safe to expose at runtime.
NEXT_PUBLIC_TAWK_PROPERTY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_TAWK_WIDGET_ID=xxxxxxxxx

# UpliftAI blog token (server-side only — used to fetch /blog content)
UPLIFTAI_TOKEN=uai_xxxxxxxxxxxxxxxxxxxxxxxx

# Resend — sends contact-form submissions to the motel's Outlook inbox.
# 1. Sign up free at https://resend.com
# 2. Verify briarcliffmotel.com (DNS records — TXT, DKIM, SPF) so emails come from your own domain.
# 3. Until verified, set CONTACT_FROM_EMAIL=onboarding@resend.dev for testing.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
CONTACT_FROM_EMAIL=notifications@briarcliffmotel.com
CONTACT_TO_EMAIL=info@briarcliffmotel.com
